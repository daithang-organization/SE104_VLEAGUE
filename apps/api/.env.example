NODE_ENV=development
PORT=8080

# Database connection
# Credentials khớp với docker-compose.yml và infra/docker-compose.db.yml
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vleague?schema=public

# JWT configuration - Change in production!
# Access token (short-lived)
JWT_ACCESS_SECRET=dev-access-secret-change-in-production
JWT_ACCESS_TTL=15m

# Refresh token (long-lived)
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_REFRESH_TTL=7d

# ===========================================
# MAIL CONFIGURATION
# ===========================================
# SMTP Server settings
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM=noreply@vleague.local

# For development, you can use Mailtrap (https://mailtrap.io)
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USER=your-mailtrap-user
# MAIL_PASS=your-mailtrap-pass
