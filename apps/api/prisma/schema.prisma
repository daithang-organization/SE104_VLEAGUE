generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── ENUMS ───────────────────────────────

enum TeamStatus {
  ACTIVE
  INACTIVE
}

enum PlayerPosition {
  GK
  DF
  MF
  FW
}

enum PlayerType {
  DOMESTIC
  FOREIGN
}

enum MatchStatus {
  DRAFT
  PUBLISHED
  LOCKED
  FINISHED
  POSTPONED
}

enum SeasonStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
}

enum SeasonTeamStatus {
  REGISTERED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum EventType {
  GOAL
  OWN_GOAL
  YELLOW_CARD
  RED_CARD
  SUBSTITUTION
}

enum UserRole {
  ADMIN
  TEAM_MANAGER
  REFEREE
  SUPERVISOR
  PUBLIC
}

enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// ─────────────────────── 1) ROLES ────────────────────────

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]

  @@map("roles")
}

// ─────────────────────── 2) USERS ────────────────────────

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  passwordHash  String?   @map("password_hash")
  role          UserRole  @default(PUBLIC)
  roleId        String?   @map("role_id") @db.Uuid
  roleRef       Role?     @relation(fields: [roleId], references: [id])
  emailVerified Boolean   @default(false) @map("email_verified")

  // Profile fields
  name          String?
  avatarUrl     String?   @map("avatar_url")

  // OAuth fields
  googleId      String?   @unique @map("google_id")
  facebookId    String?   @unique @map("facebook_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  otpCodes      OtpCode[]

  @@index([roleId])
  @@map("users")
}

// ─────────────────────── 3) REFRESH_TOKENS ───────────────

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Session info
  userAgent   String?   @map("user_agent")
  ipAddress   String?   @map("ip_address")
  deviceName  String?   @map("device_name")
  lastUsedAt  DateTime? @map("last_used_at")

  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────── 4) OTP_CODES ────────────────────

model OtpCode {
  id        String   @id @default(uuid()) @db.Uuid
  code      String
  type      OtpType
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  usedAt    DateTime? @map("used_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([code, type])
  @@map("otp_codes")
}

// ─────────────────────── 5) STADIUMS ─────────────────────

model Stadium {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  address   String?
  city      String
  capacity  Int?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  matches   Match[]
  teams     Team[]

  @@map("stadiums")
}

// ─────────────────────── 6) TEAMS ────────────────────────

model Team {
  id         String     @id @default(uuid()) @db.Uuid
  name       String     @unique
  shortName  String?    @map("short_name")
  logoUrl    String?    @map("logo_url")
  city       String?
  status     TeamStatus @default(ACTIVE)
  stadiumId  String?    @map("stadium_id") @db.Uuid
  stadium    Stadium?   @relation(fields: [stadiumId], references: [id])

  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  homeMatches  Match[]       @relation("HomeTeam")
  awayMatches  Match[]       @relation("AwayTeam")
  teamPlayers  TeamPlayer[]
  matchEvents  MatchEvent[]
  seasonTeams  SeasonTeam[]
  standings    Standing[]

  @@map("teams")
}

// ─────────────────────── 7) SEASONS ──────────────────────

model Season {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @unique
  year      Int
  status    SeasonStatus @default(UPCOMING)
  startDate DateTime?    @map("start_date")
  endDate   DateTime?    @map("end_date")

  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  matches     Match[]
  regulations Regulation[]
  seasonTeams SeasonTeam[]
  standings   Standing[]

  @@map("seasons")
}

// ─────────────────────── 8) PLAYERS ──────────────────────

model Player {
  id          String         @id @default(uuid()) @db.Uuid
  fullName    String         @map("full_name")
  dob         DateTime
  nationality String
  position    PlayerPosition
  playerType  PlayerType     @default(DOMESTIC) @map("player_type")
  birthPlace  String?        @map("birth_place")
  heightCm    Int?           @map("height_cm")
  weightKg    Int?           @map("weight_kg")

  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  teamPlayers       TeamPlayer[]
  matchEvents       MatchEvent[] @relation("MainPlayer")
  relatedEvents     MatchEvent[] @relation("RelatedPlayer")

  @@index([fullName])
  @@index([nationality])
  @@index([position])
  @@index([playerType])
  @@map("players")
}

// ─────────────────────── 9) TEAM_PLAYERS ─────────────────

model TeamPlayer {
  id           String    @id @default(uuid()) @db.Uuid
  teamId       String    @map("team_id") @db.Uuid
  playerId     String    @map("player_id") @db.Uuid
  jerseyNumber Int?      @map("jersey_number")
  joinedAt     DateTime  @default(now()) @map("joined_at")
  leftAt       DateTime? @map("left_at")

  team         Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player       Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([teamId, playerId, joinedAt])
  @@index([teamId])
  @@index([playerId])
  @@map("team_players")
}

// ─────────────────────── 10) SEASON_TEAMS ────────────────

model SeasonTeam {
  id           String           @id @default(uuid()) @db.Uuid
  seasonId     String           @map("season_id") @db.Uuid
  season       Season           @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  teamId       String           @map("team_id") @db.Uuid
  team         Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  status       SeasonTeamStatus @default(REGISTERED)
  registeredAt DateTime         @default(now()) @map("registered_at")
  approvedAt   DateTime?        @map("approved_at")

  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@unique([seasonId, teamId])
  @@index([seasonId])
  @@index([teamId])
  @@map("season_teams")
}

// ─────────────────────── 11) MATCHES ─────────────────────

model Match {
  id         String      @id @default(uuid()) @db.Uuid

  roundNo    Int         @map("round_no")
  leg        Int         @default(1)
  seasonId   String?     @map("season_id") @db.Uuid
  season     Season?     @relation(fields: [seasonId], references: [id])

  homeTeamId String      @map("home_team_id") @db.Uuid
  awayTeamId String      @map("away_team_id") @db.Uuid
  homeTeam   Team        @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam   Team        @relation("AwayTeam", fields: [awayTeamId], references: [id])

  homeScore  Int?        @map("home_score")
  awayScore  Int?        @map("away_score")

  stadiumId  String?     @map("stadium_id") @db.Uuid
  stadium    Stadium?    @relation(fields: [stadiumId], references: [id])
  kickoffAt  DateTime?   @map("kickoff_at")

  status     MatchStatus @default(DRAFT)

  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  events     MatchEvent[]

  @@index([roundNo])
  @@index([status])
  @@index([kickoffAt])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([seasonId])
  @@index([seasonId, roundNo])
  @@map("matches")
}

// ─────────────────────── 12) MATCH_EVENTS ────────────────

model MatchEvent {
  id              String    @id @default(uuid()) @db.Uuid
  matchId         String    @map("match_id") @db.Uuid
  match           Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)

  minute          Int
  type            EventType
  goalType        String?   @map("goal_type")

  playerId        String?   @map("player_id") @db.Uuid
  player          Player?   @relation("MainPlayer", fields: [playerId], references: [id])

  relatedPlayerId String?   @map("related_player_id") @db.Uuid
  relatedPlayer   Player?   @relation("RelatedPlayer", fields: [relatedPlayerId], references: [id])

  teamId          String?   @map("team_id") @db.Uuid
  team            Team?     @relation(fields: [teamId], references: [id])

  note            String?

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([matchId])
  @@index([playerId])
  @@index([teamId])
  @@index([type])
  @@map("match_events")
}

// ─────────────────────── 13) REGULATIONS ─────────────────

model Regulation {
  id        String   @id @default(uuid()) @db.Uuid
  seasonId  String   @map("season_id") @db.Uuid
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  key       String
  value     String
  valueType String   @map("value_type")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([seasonId, key])
  @@index([seasonId])
  @@map("regulations")
}

// ─────────────────────── 14) STANDINGS ───────────────────

model Standing {
  id           String   @id @default(uuid()) @db.Uuid
  seasonId     String   @map("season_id") @db.Uuid
  season       Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  teamId       String   @map("team_id") @db.Uuid
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  played       Int      @default(0)
  win          Int      @default(0)
  draw         Int      @default(0)
  loss         Int      @default(0)
  goalsFor     Int      @default(0) @map("goals_for")
  goalsAgainst Int      @default(0) @map("goals_against")
  goalDiff     Int      @default(0) @map("goal_diff")
  points       Int      @default(0)
  rank         Int?

  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([seasonId, teamId])
  @@index([seasonId])
  @@map("standings")
}
