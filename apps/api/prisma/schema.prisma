generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────

enum TeamStatus {
  ACTIVE
  INACTIVE
}

enum PlayerPosition {
  GK
  DF
  MF
  FW
}

enum PlayerType {
  DOMESTIC
  FOREIGN
}

enum MatchStatus {
  DRAFT
  PUBLISHED
  LOCKED
  FINISHED
  POSTPONED
}

enum SeasonStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
}

enum SeasonTeamStatus {
  REGISTERED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum EventType {
  GOAL
  OWN_GOAL
  YELLOW_CARD
  RED_CARD
  SUBSTITUTION
  PENALTY
  PENALTY_MISS
}

enum UserRole {
  ADMIN
  TEAM_MANAGER
  REFEREE
  SUPERVISOR
  PUBLIC
}

enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// ─── Auth Models ────────────────────────────────────────────

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  passwordHash  String?  @map("password_hash")
  role          UserRole @default(PUBLIC)
  emailVerified Boolean  @default(false) @map("email_verified")

  // Profile fields
  name      String?
  avatarUrl String? @map("avatar_url")

  // OAuth fields
  googleId   String? @unique @map("google_id")
  facebookId String? @unique @map("facebook_id")

  // Role FK
  roleId String? @map("role_id") @db.Uuid
  roleRef Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  otpCodes      OtpCode[]
  teamManagerAssignments TeamManagerAssignment[]

  @@index([roleId])
  @@map("users")
}

model OtpCode {
  id     String  @id @default(uuid()) @db.Uuid
  code   String
  type   OtpType
  userId String  @map("user_id") @db.Uuid
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  usedAt    DateTime? @map("used_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([code, type])
  @@map("otp_codes")
}

model RefreshToken {
  id        String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @map("token_hash")
  userId    String @map("user_id") @db.Uuid
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Session info
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  deviceName String?   @map("device_name")
  lastUsedAt DateTime? @map("last_used_at")

  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

// ─── Core Domain Models ─────────────────────────────────────

model Team {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  shortName String?    @map("short_name")
  city      String?
  logoUrl   String?    @map("logo_url")
  status    TeamStatus @default(ACTIVE)

  stadiumId String?  @map("stadium_id") @db.Uuid
  stadium   Stadium? @relation(fields: [stadiumId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  roster       TeamPlayer[]
  seasonTeams  SeasonTeam[]
  homeMatches  Match[]        @relation("HomeTeam")
  awayMatches  Match[]        @relation("AwayTeam")
  matchEvents  MatchEvent[]
  standings    Standing[]
  managerAssignments TeamManagerAssignment[]

  @@map("teams")
}

model Player {
  id          String         @id @default(uuid()) @db.Uuid
  fullName    String         @map("full_name")
  dob         DateTime
  nationality String
  position    PlayerPosition
  birthPlace  String?        @map("birth_place")
  heightCm    Int?           @map("height_cm")
  weightKg    Int?           @map("weight_kg")
  playerType  PlayerType     @default(DOMESTIC) @map("player_type")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  roster        TeamPlayer[]
  matchEvents   MatchEvent[] @relation("EventPlayer")
  relatedEvents MatchEvent[] @relation("RelatedPlayer")

  @@index([fullName], map: "players_full_name_idx")
  @@index([nationality], map: "players_nationality_idx")
  @@index([position], map: "players_position_idx")
  @@index([playerType], map: "players_player_type_idx")
  @@map("players")
}

model Stadium {
  id       String @id @default(uuid()) @db.Uuid
  name     String @unique
  address  String?
  city     String
  capacity Int?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  teams   Team[]
  matches Match[]

  @@map("stadiums")
}

model Season {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @unique
  year      Int
  status    SeasonStatus @default(UPCOMING)
  startDate DateTime?    @map("start_date")
  endDate   DateTime?    @map("end_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  matches     Match[]
  seasonTeams SeasonTeam[]
  regulations Regulation[]
  standings   Standing[]
  managerAssignments TeamManagerAssignment[]

  @@map("seasons")
}

// ─── Junction / Association Models ──────────────────────────

model TeamPlayer {
  id           String    @id @default(uuid()) @db.Uuid
  teamId       String    @map("team_id") @db.Uuid
  team         Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId     String    @map("player_id") @db.Uuid
  player       Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  jerseyNumber Int?      @map("jersey_number")
  joinedAt     DateTime  @default(now()) @map("joined_at")
  leftAt       DateTime? @map("left_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([teamId, playerId, joinedAt])
  @@index([teamId])
  @@index([playerId])
  @@map("team_players")
}

model SeasonTeam {
  id       String           @id @default(uuid()) @db.Uuid
  seasonId String           @map("season_id") @db.Uuid
  season   Season           @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  teamId   String           @map("team_id") @db.Uuid
  team     Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  status   SeasonTeamStatus @default(REGISTERED)

  registeredAt DateTime  @default(now()) @map("registered_at")
  approvedAt   DateTime? @map("approved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([seasonId, teamId])
  @@index([seasonId])
  @@index([teamId])
  @@map("season_teams")
}

// ─── Match Models ───────────────────────────────────────────

model Match {
  id String @id @default(uuid()) @db.Uuid

  roundNo Int @map("round_no")
  leg     Int @default(1)

  seasonId String? @map("season_id") @db.Uuid
  season   Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  homeTeamId String @map("home_team_id") @db.Uuid
  homeTeam   Team   @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeamId String @map("away_team_id") @db.Uuid
  awayTeam   Team   @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Restrict)

  stadiumId String?  @map("stadium_id") @db.Uuid
  stadium   Stadium? @relation(fields: [stadiumId], references: [id], onDelete: SetNull)

  kickoffAt DateTime? @map("kickoff_at")
  homeScore Int?      @map("home_score")
  awayScore Int?      @map("away_score")

  status MatchStatus @default(DRAFT)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  events  MatchEvent[]

  @@index([roundNo], map: "matches_round_no_idx")
  @@index([status], map: "matches_status_idx")
  @@index([kickoffAt], map: "matches_kickoff_at_idx")
  @@index([homeTeamId], map: "matches_home_team_id_idx")
  @@index([awayTeamId], map: "matches_away_team_id_idx")
  @@index([seasonId], map: "matches_season_id_idx")
  @@index([seasonId, roundNo], map: "matches_season_id_round_no_idx")
  @@map("matches")
}

model MatchEvent {
  id      String    @id @default(uuid()) @db.Uuid
  matchId String    @map("match_id") @db.Uuid
  match   Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  minute  Int
  type    EventType

  goalType String? @map("goal_type")

  playerId        String? @map("player_id") @db.Uuid
  player          Player? @relation("EventPlayer", fields: [playerId], references: [id], onDelete: SetNull)
  relatedPlayerId String? @map("related_player_id") @db.Uuid
  relatedPlayer   Player? @relation("RelatedPlayer", fields: [relatedPlayerId], references: [id], onDelete: SetNull)
  teamId          String? @map("team_id") @db.Uuid
  team            Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  note String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([matchId])
  @@index([playerId])
  @@index([teamId])
  @@index([type], map: "match_events_type_idx")
  @@map("match_events")
}

// ─── Regulation & Standings ─────────────────────────────────

model Regulation {
  id        String @id @default(uuid()) @db.Uuid
  seasonId  String @map("season_id") @db.Uuid
  season    Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  key       String
  value     String
  valueType String @map("value_type")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([seasonId, key])
  @@index([seasonId])
  @@map("regulations")
}

model Standing {
  id           String @id @default(uuid()) @db.Uuid
  seasonId     String @map("season_id") @db.Uuid
  season       Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  teamId       String @map("team_id") @db.Uuid
  team         Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  played       Int    @default(0)
  win          Int    @default(0)
  draw         Int    @default(0)
  loss         Int    @default(0)
  goalsFor     Int    @default(0) @map("goals_for")
  goalsAgainst Int    @default(0) @map("goals_against")
  goalDiff     Int    @default(0) @map("goal_diff")
  points       Int    @default(0)
  rank         Int?

  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([seasonId, teamId])
  @@index([seasonId])
  @@map("standings")
}

model TeamManagerAssignment {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @map("user_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  seasonId String @map("season_id") @db.Uuid
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  teamId   String @map("team_id") @db.Uuid
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, seasonId])
  @@index([teamId])
  @@index([seasonId])
  @@map("team_manager_assignments")
}

// ─── Audit Log ──────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  userEmail String?  @map("user_email")
  action    String   // CREATE, UPDATE, DELETE, STATUS_CHANGE
  entity    String   // teams, players, matches, etc.
  entityId  String?  @map("entity_id")
  oldValue  String?  @map("old_value") @db.Text
  newValue  String?  @map("new_value") @db.Text
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Notifications ──────────────────────────────────────────

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  title      String
  message    String
  type       String    // MATCH_RESULT, STATUS_CHANGE, SCHEDULE_CHANGE, SYSTEM
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id")
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@index([type])
  @@map("notifications")
}
