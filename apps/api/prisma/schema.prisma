generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TeamStatus {
  ACTIVE
  INACTIVE
}

enum PlayerPosition {
  GK
  DF
  MF
  FW
}

enum MatchStatus {
  DRAFT
  PUBLISHED
  LOCKED
}

enum SeasonStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
}

enum EventType {
  GOAL
  OWN_GOAL
  YELLOW_CARD
  RED_CARD
  SUBSTITUTION
}

enum UserRole {
  ADMIN
  TEAM_MANAGER
  REFEREE
  SUPERVISOR
  PUBLIC
}

enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String?   @map("password_hash")
  role          UserRole  @default(PUBLIC)
  emailVerified Boolean   @default(false) @map("email_verified")

  // Profile fields
  name          String?
  avatarUrl     String?   @map("avatar_url")

  // OAuth fields
  googleId      String?   @unique @map("google_id")
  facebookId    String?   @unique @map("facebook_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  otpCodes      OtpCode[]

  @@map("users")
}

model OtpCode {
  id        String   @id @default(uuid())
  code      String
  type      OtpType
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  usedAt    DateTime? @map("used_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([code, type])
  @@map("otp_codes")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Session info
  userAgent   String?   @map("user_agent")
  ipAddress   String?   @map("ip_address")
  deviceName  String?   @map("device_name")
  lastUsedAt  DateTime? @map("last_used_at")

  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model Season {
  id        String       @id @default(uuid())
  name      String       @unique
  year      Int
  status    SeasonStatus @default(UPCOMING)
  startDate DateTime?    @map("start_date")
  endDate   DateTime?    @map("end_date")

  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  matches   Match[]

  @@map("seasons")
}

model Stadium {
  id        String   @id @default(uuid())
  name      String   @unique
  city      String
  capacity  Int?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  matches   Match[]
  teams     Team[]

  @@map("stadiums")
}

model Team {
  id         String     @id @default(uuid())
  name       String     @unique
  status     TeamStatus @default(ACTIVE)
  stadiumId  String?    @map("stadium_id")
  stadium    Stadium?   @relation(fields: [stadiumId], references: [id])

  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  homeMatches  Match[]      @relation("HomeTeam")
  awayMatches  Match[]      @relation("AwayTeam")
  teamPlayers  TeamPlayer[]
  matchEvents  MatchEvent[]

  @@map("teams")
}

model Player {
  id          String         @id @default(uuid())
  fullName    String         @map("full_name")
  dob         DateTime
  nationality String
  position    PlayerPosition

  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  teamPlayers TeamPlayer[]
  matchEvents MatchEvent[]

  @@index([fullName])
  @@index([nationality])
  @@index([position])
  @@map("players")
}

model TeamPlayer {
  id        String   @id @default(uuid())
  teamId    String   @map("team_id")
  playerId  String   @map("player_id")
  jerseyNumber  Int?     @map("jersey_number")
  joinedAt  DateTime @default(now()) @map("joined_at")
  leftAt    DateTime? @map("left_at")

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([teamId, playerId, joinedAt])
  @@index([teamId])
  @@index([playerId])
  @@map("team_players")
}

model Match {
  id         String      @id @default(uuid())

  roundNo    Int         @map("round_no")
  seasonId   String?     @map("season_id")
  season     Season?     @relation(fields: [seasonId], references: [id])

  homeTeamId String      @map("home_team_id")
  awayTeamId String      @map("away_team_id")
  homeTeam   Team        @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam   Team        @relation("AwayTeam", fields: [awayTeamId], references: [id])

  homeScore  Int?        @map("home_score")
  awayScore  Int?        @map("away_score")

  stadiumId  String?     @map("stadium_id")
  stadium    Stadium?    @relation(fields: [stadiumId], references: [id])
  kickoffAt  DateTime?   @map("kickoff_at")

  status     MatchStatus @default(DRAFT)

  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  events     MatchEvent[]

  @@index([roundNo])
  @@index([status])
  @@index([kickoffAt])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([seasonId])
  @@map("matches")
}

model MatchEvent {
  id        String    @id @default(uuid())
  matchId   String    @map("match_id")
  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)

  minute    Int
  type      EventType

  playerId  String?   @map("player_id")
  player    Player?   @relation(fields: [playerId], references: [id])

  teamId    String?   @map("team_id")
  team      Team?     @relation(fields: [teamId], references: [id])

  note      String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([matchId])
  @@index([playerId])
  @@index([teamId])
  @@map("match_events")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

