{
  "name": "se104-vleague",
  "version": "1.0.0",
  "private": true,
  "description": "SE104 VLeague Project",
  "scripts": {
    "setup": "node -e \"require('child_process').execSync(process.platform === 'win32' ? 'powershell -ExecutionPolicy Bypass -File .\\\\scripts\\\\setup.ps1' : 'bash scripts/setup.sh', {stdio: 'inherit'})\"",
    "dev": "pnpm --parallel run dev",
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive run test",
    "lint": "pnpm --recursive run lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "prepare": "husky",
    "seed:real": "pnpm --filter api exec tsx apps/api/prisma/setup-vleague-2024.ts",
    "seed:vleague-2025": "pnpm --dir apps/api exec tsx prisma/setup-vleague-2025.ts",
    "seed:tie-goal-diff": "pnpm --dir apps/api exec tsx prisma/seed-standings-tie-scenarios.ts goal-diff",
    "seed:tie-draw-lot": "pnpm --dir apps/api exec tsx prisma/seed-standings-tie-scenarios.ts draw-lot",
    "seed:tie-scenarios": "pnpm --dir apps/api exec tsx prisma/seed-standings-tie-scenarios.ts all",
    "db:seed": "pnpm --filter api exec prisma db seed",
    "repair:users": "pnpm --filter api exec tsx apps/api/prisma/repair-users.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.2.0",
    "typescript-eslint": "^8.54.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,css,html}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
