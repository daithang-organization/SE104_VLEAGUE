  indexes {
    manager_id
    team_id
    player_id
    status
    request_type
    reviewed_by_id
  }
}

// 9) manager_stadium_requests
Table manager_stadium_requests {
  id             uuid [pk, not null, default: `gen_random_uuid()`]
  manager_id     uuid [not null, ref: > users.id]
