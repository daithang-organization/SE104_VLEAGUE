  proposed_stadium_id      uuid
  request_note             text
  admin_note               text
  reviewed_by_id           uuid [ref: > users.id]
  reviewed_at              timestamp
  created_at               timestamp [not null, default: `now()`]
  updated_at               timestamp [not null]

  indexes {
    manager_id
    team_id
    status
    request_type
    reviewed_by_id
  }
}

// 8) manager_player_requests
Table manager_player_requests {
  id             uuid [pk, not null, default: `gen_random_uuid()`]
  manager_id     uuid [not null, ref: > users.id]
